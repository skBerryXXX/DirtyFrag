<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <df.root.AuroraBackgroundView
        android:id="@+id/bgAurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:fitsSystemWindows="true">

        <android.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@android:color/transparent"
            android:contentInsetStart="0dp"
            android:contentInsetStartWithNavigation="0dp"
            android:title="@string/app_name"
            android:titleMarginStart="22dp"
            android:titleTextAppearance="@style/ToolbarTitle">

            <FrameLayout
                android:id="@+id/updatePill"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="22dp"
                android:background="@drawable/bg_update_pill"
                android:clickable="true"
                android:contentDescription="@string/update_available_description"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/updateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:text="@string/update"
                    android:textColor="#FF04120E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/odinPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_odin_pill"
                android:clickable="true"
                android:contentDescription="@string/recovery_description"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="40dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <View
                    android:id="@+id/odinDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="#FF8A97A8" />

                <TextView
                    android:id="@+id/odinLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.04"
                    android:text="@string/recovery"
                    android:textColor="#FFD6DEE8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/menu"
                android:scaleType="center"
                android:src="@drawable/ic_more"
                android:tint="#FFD6DEE8" />

        </android.widget.Toolbar>

    </FrameLayout>

    <View
        android:id="@+id/menuAnchor"
        android:layout_width="8dp"
        android:layout_height="2dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/appBarLayout"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_below="@id/appBarLayout"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_orb">

            <View
                android:id="@+id/heroDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dot"
                android:backgroundTint="#FF8A97A8" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.01"
                android:text="@string/hero_not_rooted"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/hero_idle_sub"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/heroVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_version_chip"
            android:letterSpacing="0.04"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:textColor="#FFB9C6D6"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <df.root.CardStackLayout
        android:id="@+id/cardStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/hero"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_slide_fade"
        android:orientation="vertical">

        <df.root.DraggableCardView
            android:id="@+id/cardSuManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="#552BE8B0">

            <LinearLayout
                android:id="@+id/rowSuManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_row_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_chip">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        android:tint="#FF2BE8B0" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.01"
                        android:text="@string/su_manager"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/suManagerSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/su_manager_required"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/chevronSuManager"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/select"
                    android:src="@drawable/ic_chevron"
                    android:tint="#FF8A97A8" />

            </LinearLayout>

        </df.root.DraggableCardView>

        <df.root.DraggableCardView
            android:id="@+id/cardBoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="#337C5CFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_chip_violet">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_power"
                            android:tint="#FF8B6BFF" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAutorunTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/autorun"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAutorunDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/autorun_description"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                    </LinearLayout>

                    <df.root.OneUiSwitch
                        android:id="@+id/switchBootStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRebootTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_reboot"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvRebootDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_reboot_description"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                    </LinearLayout>

                    <df.root.OneUiSwitch
                        android:id="@+id/switchAutoSoftReboot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

        </df.root.DraggableCardView>

        <df.root.DraggableCardView
            android:id="@+id/cardModules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="#262BE8FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_chip_blue">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cube"
                        android:tint="#FF3AA0FF" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ksu_modules"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/modulesSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/modules_enabled"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                </LinearLayout>

                <df.root.OneUiSwitch
                    android:id="@+id/switchModules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:checked="true" />

            </LinearLayout>

        </df.root.DraggableCardView>

        <df.root.DraggableCardView
            android:id="@+id/cardLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_chip_grey">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_terminal"
                        android:tint="#FFD6DEE8" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/advanced_log"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/advanced_log_description"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                </LinearLayout>

                <df.root.OneUiSwitch
                    android:id="@+id/switchAdvancedLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </df.root.DraggableCardView>

    </df.root.CardStackLayout>

    <FrameLayout
        android:id="@+id/logWindow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/log_window_height"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_console">

        <ScrollView
            android:id="@+id/outputScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/outputView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1.5dp"
                android:textColor="#FFA9B8C9"
                android:textIsSelectable="false"
                android:textSize="11sp" />

        </ScrollView>

        <df.root.BottomFadeView
            android:id="@+id/bottomFade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

    </FrameLayout>

    <df.root.TwoStepProgressView
        android:id="@+id/twoStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btnRun"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp" />

    <df.root.PillButton
        android:id="@+id/btnRun"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#FF2BE8B0"
        android:elevation="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.02"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:stateListAnimator="@null"
        android:text="@string/run_exploit"
        android:textColor="#FF04120E"
        android:textSize="15sp"
        android:textStyle="bold"
        app:strokeColor="#662BE8B0"
        app:strokeWidth="1dp" />

    <FrameLayout
        android:id="@+id/btnKsu"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="24dp"
        android:layout_toEndOf="@id/btnRun"
        android:background="@drawable/bg_pill"
        android:backgroundTint="#1AFFFFFF"
        android:clickable="true"
        android:contentDescription="@string/open_su_manager"
        android:elevation="14dp"
        android:enabled="false"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/ksuLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="22dp"
            android:alpha="0"
            android:letterSpacing="0.02"
            android:text="@string/manager"
            android:textColor="#FF04120E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ksuChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="19dp"
            android:contentDescription="@string/open"
            android:src="@drawable/ic_chevron"
            android:tint="#FF8A97A8" />

    </FrameLayout>

    <ImageButton
        android:id="@+id/btnShareLog"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignBottom="@id/btnRun"
        android:layout_marginStart="33dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/save_log"
        android:elevation="14dp"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_share"
        android:tint="#FF8A97A8"
        android:visibility="gone" />

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:background="#D905070B"
        android:elevation="30dp"
        android:visibility="gone" />

</RelativeLayout>
